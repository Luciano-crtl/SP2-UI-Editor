<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SP2UIEditor</AssemblyName>
    <RootNamespace>SP2UIEditor</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SimplePlanes 2</GameDir>
    <M Condition="'$(M)' == ''">$(GameDir)\SimplePlanes 2_Data\Managed</M>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\*.cs" LinkBase="Core" />
    <EmbeddedResource Include="page.html" LogicalName="page.html" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="False" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="False" />
    <Reference Include="$(M)\Game.dll" Private="False" />
    <Reference Include="$(M)\UnityEngine.dll" Private="False" />
    <Reference Include="$(M)\UnityEngine.CoreModule.dll" Private="False" />
    <Reference Include="$(M)\UnityEngine.UIModule.dll" Private="False" />
    <Reference Include="$(M)\UnityEngine.UI.dll" Private="False" />
    <Reference Include="$(M)\Unity.TextMeshPro.dll" Private="False" />
    <Reference Include="$(M)\Unity.InputSystem.dll" Private="False" />
    <Reference Include="$(M)\UnityEngine.ScreenCaptureModule.dll" Private="False" />
    <Reference Include="$(M)\UnityEngine.ImageConversionModule.dll" Private="False" />
    <Reference Include="$(M)\Jundroo.Packages.dll" Private="False" />
    <Reference Include="$(M)\Jundroo.Common.dll" Private="False" />
    <Reference Include="$(M)\Newtonsoft.Json.dll" Private="False" />
  </ItemGroup>
</Project>
